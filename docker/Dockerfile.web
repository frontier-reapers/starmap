# Dockerfile for serving the starmap web application
FROM nginx:alpine

# Copy application files
COPY public/ /usr/share/nginx/html/public/
COPY src/ /usr/share/nginx/html/src/

# Generate build info for cache-busting (if git info is available)
RUN if command -v git &> /dev/null; then \
    echo '{"commit":"docker-build","timestamp":'$(date +%s)'000,"buildDate":"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"}' > /usr/share/nginx/html/public/build-info.json; \
    fi

# Create a custom nginx config to serve from root and handle routing
RUN echo 'server {' > /etc/nginx/conf.d/default.conf && \
    echo '    listen 80;' >> /etc/nginx/conf.d/default.conf && \
    echo '    server_name localhost;' >> /etc/nginx/conf.d/default.conf && \
    echo '    root /usr/share/nginx/html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    index public/index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    location / {' >> /etc/nginx/conf.d/default.conf && \
    echo '        try_files $uri $uri/ /public/index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '    # MIME types for JS modules' >> /etc/nginx/conf.d/default.conf && \
    echo '    types {' >> /etc/nginx/conf.d/default.conf && \
    echo '        application/javascript js mjs;' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '}' >> /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
